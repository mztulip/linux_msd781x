// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "kronus-msd7816.dtsi"

/ {
	compatible = "mstar,msd7816", "mstar,kronus";
	model = "MStar MSD7816 test";

	aliases {
		serial0 = &piu_uart0;
	};

	chosen {
		bootargs = "console=ttyS0,115200 root=/dev/sda2 rootwait clk_ignore_unused rw fbcon=font:TER16x32";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* two 1920x1080 RGB565 buffers for mstar-gopfb (2 x 0x3f4800) */
		fb_memory: fb-memory@2100000 {
			reg = <0x2100000 0x900000>;
		};

		/* ve framebuffer */
		ve-memory@3200000 {
			reg = <0x3200000 0x1a0000>;
		};

		/* reserve this for our experiments */
		tsukasa@3c00000 {
			reg = <0x3c00000 0x400000>;
		};
	};
};


&isp {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	flash@0 {
		compatible = "macronix,mx25l8005", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <54000000>; /* something like that */
		m25p,fast-read;

		partitions {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "fixed-partitions";

			sboot@0 {
				label = "sboot";
				reg = <0x0 0x10000>;
			};

			u-boot@10000 {
				label = "u-boot";
				reg = <0x10000 0xd0000>;
			};

			u-boot-env@e0000 {
				label = "u-boot env";
				reg = <0xe0000 0x20000>;
			};
		};
	};
};

/*
 * Port 0, pad mode 1 (chiptop 0x1E12 = 1, as set by MBoot's tuner_init).
 * The only device answering on this bus is the MxL5007T tuner at 0x60.
 */
&miic0 {
	#address-cells = <1>;
	#size-cells = <0>;
	mstar,chiptop = <&chiptop>;
	mstar,port = <0>;
	mstar,pad-mode = <1>;
	status = "okay";
};

&riu {
	/*
	 * Front panel: FD650-style key/display controller bit-banged on PM SAR
	 * pins 1 (DIO) and 2 (CLK). reg covers the SAR pin mode/GPIO registers
	 * 0x1422-0x1425 (PM bank 0x1400 + 0x20 words).
	 */
	front-panel@2840 {
		compatible = "mstar,msd7816-fd650-panel";
		reg = <0x2840 0x10>;
	};
};

&usb_phy2 {
	status = "okay";
};

&uhc2 {
	status = "okay";
};

&piu_uart0 {
	status = "okay";
};

/*
 * Linux framebuffer on GOP3, double buffered (mstar-gopfb). Buffer 0 is the
 * one MBoot/logofix leave on screen at 0x2100000.
 */
&riu {
	gop3-fb@203e00 {
		compatible = "mstar,msd7816-gop3-fb";
		reg = <0x203e00 0x200>,		/* GOP regs 0x1F00-0x1FFF */
		      <0x202400 0x200>;		/* MIU0 regs 0x1200-0x12FF (arbitration) */
		interrupts-extended = <&intc_irq 20 IRQ_TYPE_LEVEL_HIGH>;	/* GOP vsync */
		memory-region = <&fb_memory>;
		width = <1920>;
		height = <1080>;
	};
};
